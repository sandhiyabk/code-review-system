GROQ_API_KEY=your_groq_api_key_here
GITHUB_TOKEN=optional_for_higher_rate_limits

# ── Optional LLM backend configuration ────────────────────
# The app auto-detects: Groq (when GROQ_API_KEY set) → Ollama (local)
# → OpenAI (when OPENAI_API_KEY set) → custom base_url. Force one with:
#
# LLM_BACKEND=ollama                 # groq | ollama | openai | custom
# OLLAMA_HOST=http://localhost:11434 # local Ollama server (default)
# LLM_MODEL=llama3.2                 # override the default model for any backend
#
# OpenAI / custom OpenAI-compatible endpoint (LM Studio, LocalAI, ...):
# OPENAI_API_KEY=your_openai_key
# OPENAI_BASE_URL=http://localhost:1234/v1
